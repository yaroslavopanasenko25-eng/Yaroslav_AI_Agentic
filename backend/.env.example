# Copy to .env (or run the server — it auto-copies this file on first start).
# Demo placeholders below let the API work immediately after git clone.

# ── Supabase (optional — history falls back to local JSON + demo data) ───────
SUPABASE_URL=https://demo-not-configured.supabase.co
SUPABASE_KEY=demo-not-configured

# ── Grok / xAI (optional — chat uses rule-based dispatcher in demo mode) ───────
# Get a key: https://console.x.ai/
GROK_API_KEY=demo-not-configured
GROK_API_URL=https://api.x.ai/v1/chat/completions
GROK_MODEL=grok-3-mini

# ── alerts.in.ua (optional — map uses demo layout until key is set) ───────────
# Register: https://alerts.in.ua/
ALERTS_API_KEY=your-alerts-in-ua-token
ALERTS_API_URL=https://api.alerts.in.ua/v1/alerts/active.json

# ── Server ────────────────────────────────────────────────────────────────────
DEBUG=false
HOST=0.0.0.0
PORT=8080
CORS_ALLOW_LAN=true

# Production: comma-separated public URLs
# ALLOWED_ORIGINS=https://your-domain.com
