# Copy this file to .env and fill in your real values.
# Never commit .env — it is listed in .gitignore.

# ── Supabase ──────────────────────────────────────────────────────────────────
# Find these in: Supabase dashboard → Project Settings → API
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_KEY=<service-role-key>           # use the service-role key for backend writes

# ── Grok (xAI) ────────────────────────────────────────────────────────────────
# Get your key at: https://console.x.ai/
# Both naming conventions are supported:
GROK_API_KEY=xai-<your-key>
# XAI_API_KEY=xai-<your-key>
GROK_API_URL=https://api.x.ai/v1/chat/completions
# XAI_BASE_URL=https://api.x.ai/v1
GROK_MODEL=grok-3-mini                    # grok-3, grok-3-mini, etc.
# XAI_MODEL=grok-3-mini

# ── alerts.in.ua ──────────────────────────────────────────────────────────────
# Register and get your token at: https://alerts.in.ua/
ALERTS_API_KEY=<your-alerts-in-ua-token>
ALERTS_API_URL=https://api.alerts.in.ua/v1/alerts/active.json

# ── App ───────────────────────────────────────────────────────────────────────
DEBUG=false
