# Copy to repo root as .env before: docker compose up -d --build
# On DigitalOcean App Platform: set these as encrypted Environment Variables.

# ── Your public URL (required for CORS) ───────────────────────────────────────
ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com

# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-service-role-key

# ── Grok (xAI) ────────────────────────────────────────────────────────────────
XAI_API_KEY=xai-your-key-here
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-3-mini

# ── alerts.in.ua ──────────────────────────────────────────────────────────────
ALERTS_API_KEY=your-alerts-in-ua-api-key
ALERTS_API_URL=https://api.alerts.in.ua/v1/alerts/active.json

# ── App ───────────────────────────────────────────────────────────────────────
DEBUG=false
SHELTERS_JSON_PATH=/app/data/shelters.json
